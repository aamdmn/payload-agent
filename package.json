{
  "name": "payload-agent",
  "version": "0.10.0",
  "description": "AI chat agent for Payload CMS - query and manage your content from Telegram, Slack, WhatsApp and more.",
  "keywords": [
    "payload",
    "payload-cms",
    "payloadcms",
    "plugin",
    "ai",
    "agent",
    "chatbot",
    "telegram",
    "slack",
    "whatsapp"
  ],
  "homepage": "https://github.com/aamdmn/payload-agent#readme",
  "bugs": "https://github.com/aamdmn/payload-agent/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aamdmn/payload-agent.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./next": {
      "import": "./src/next.ts",
      "types": "./src/next.ts",
      "default": "./src/next.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm copyfiles && pnpm build:types && pnpm build:swc && pnpm build:strip-tests",
    "build:strip-tests": "rimraf --glob \"dist/**/*.spec.*\"",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths",
    "build:types": "tsc --outDir dist --rootDir ./src",
    "clean": "rimraf --glob \"{dist,*.tsbuildinfo}\"",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "dev": "next dev dev --turbo",
    "dev:generate-importmap": "pnpm dev:payload generate:importmap",
    "dev:generate-types": "pnpm dev:payload generate:types",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "generate:importmap": "pnpm dev:generate-importmap",
    "generate:types": "pnpm dev:generate-types",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "test": "pnpm test:int",
    "test:e2e": "playwright test",
    "test:eval": "cross-env RUN_AGENT_EVALS=1 vitest run --config vitest.eval.config.js",
    "test:int": "vitest run",
    "prepare": "husky",
    "prepublishOnly": "node scripts/ensure-pnpm.mjs && pnpm clean && pnpm build",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@chat-adapter/telegram": "^4.29.0",
    "@payloadcms/db-sqlite": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "@playwright/test": "1.63.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "^1.16.2",
    "@tanstack/ai-anthropic": "^0.15.1",
    "@tanstack/ai-client": "^0.16.3",
    "@tanstack/ai-openai": "^0.14.1",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chat": "^4.29.0",
    "copyfiles": "2.4.1",
    "cross-env": "10.1.0",
    "graphql": "^16.14.2",
    "husky": "^9.1.7",
    "next": "16.3.5",
    "payload": "3.89.0",
    "qs-esm": "8.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "6.1.3",
    "sharp": "0.34.5",
    "typescript": "7.0.2",
    "ultracite": "7.8.0",
    "vite": "^8.3.0",
    "vitest": "5.0.1"
  },
  "peerDependencies": {
    "@chat-adapter/telegram": "^4.29.0",
    "@payloadcms/richtext-lexical": "^3.37.0",
    "@tanstack/ai-anthropic": "^0.15.1",
    "@tanstack/ai-openai": "^0.14.1",
    "chat": "^4.0.0",
    "payload": "^3.37.0"
  },
  "peerDependenciesMeta": {
    "@chat-adapter/telegram": {
      "optional": true
    },
    "@payloadcms/richtext-lexical": {
      "optional": true
    },
    "@tanstack/ai-anthropic": {
      "optional": true
    },
    "@tanstack/ai-openai": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.26.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./next": {
        "import": "./dist/next.js",
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "dependencies": {
    "@tanstack/ai": "0.28.0",
    "@tanstack/ai-code-mode": "0.2.5",
    "@tanstack/ai-isolate-node": "0.1.30",
    "zod": "^4.6.5"
  }
}
